---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="關於 About">
  <main class="page about">
    <h1 class="page-title">{site.name}</h1>
    <div class="prose about-bio">
      {site.bio.map((p) => <p>{p}</p>)}
    </div>

    <section class="about-list">
      <h2 class="note">展演紀錄 Exhibitions</h2>
      <ul>
        {site.exhibitions.map((e) => (
          <li><span class="note">{e.year}</span><strong>{e.name}</strong><span>{e.venue}</span><span class="note">{e.type}</span></li>
        ))}
      </ul>
    </section>

    <section class="about-list">
      <h2 class="note">學歷 Education</h2>
      <ul class="edu">
        {site.education.map((e) => <li><strong>{e.name}</strong><span>{e.note}</span></li>)}
      </ul>
    </section>

    <section class="about-list">
      <h2 class="note">聯絡 Contact</h2>
      <p class="contact"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="contact"><a href={site.instagram.url}>Instagram {site.instagram.handle}</a></p>
    </section>
  </main>
</Base>
